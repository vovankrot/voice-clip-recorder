<Window x:Class="VoiceClipRecorder.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice Clip Recorder — установка"
        Height="500" Width="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Border CornerRadius="10"
            Background="{StaticResource BgPanel}"
            BorderBrush="{StaticResource Stroke}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Opacity="0.55" ShadowDepth="0" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ LEFT BRAND PANEL ============ -->
            <Border Grid.Column="0" CornerRadius="10,0,0,10" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1E3A8A" Offset="0"/>
                        <GradientStop Color="#0B1226" Offset="0.55"/>
                        <GradientStop Color="#06080F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <!-- Decorative accent glow -->
                    <Ellipse Width="380" Height="380" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="-120,-120,0,0" Opacity="0.55">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#3B82F6" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="320" Height="320" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-100,-100" Opacity="0.40">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#8B5CF6" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <StackPanel VerticalAlignment="Center" Margin="36,0">
                        <!-- Vector "VCR" mic logo -->
                        <Grid Width="84" Height="84" HorizontalAlignment="Left" Margin="0,0,0,28">
                            <Ellipse Fill="#1E3A8A" Opacity="0.65"/>
                            <Path Stretch="Uniform" Width="44" Height="44" Fill="White"
                                  Data="M12 14a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v5a3 3 0 0 0 3 3zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.92V21h2v-3.08A7 7 0 0 0 19 11h-2z"/>
                        </Grid>

                        <TextBlock Text="Voice Clip"
                                   Foreground="White" FontSize="34" FontWeight="Light" LineHeight="38"/>
                        <TextBlock Text="Recorder"
                                   Foreground="White" FontSize="34" FontWeight="SemiBold" LineHeight="38" Margin="0,-4,0,16"/>
                        <TextBlock Text="Программа-помощник для записи системного звука"
                                   Foreground="#B9C4D6" FontSize="13" TextWrapping="Wrap"
                                   LineHeight="20" Width="240" HorizontalAlignment="Left"/>

                        <Border Margin="0,28,0,0" Padding="10,6"
                                Background="#1F2A44" CornerRadius="14" HorizontalAlignment="Left">
                            <TextBlock x:Name="VersionTag" Text="v1.0.0"
                                       Foreground="#9FB4DB" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ RIGHT CONTENT PANEL ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Window caption -->
                <Grid Grid.Row="0" Background="Transparent" Height="34"
                      MouseLeftButtonDown="Caption_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" Content="&#xE921;"/>
                        <Button Style="{StaticResource CaptionButtonClose}" Click="Close_Click" Content="&#xE8BB;"/>
                    </StackPanel>
                </Grid>

                <!-- Main content (stacked screens) -->
                <Grid Grid.Row="1" Margin="40,8,40,8">

                    <!-- READY screen -->
                    <StackPanel x:Name="ScreenReady" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitle"
                                   Text="Готов к установке"
                                   Foreground="{StaticResource Text}" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock x:Name="HeaderSubtitle"
                                   Text="Будет установлено приложение-помощник, которое запишет звук из Firefox и других программ. Не требует прав администратора."
                                   Foreground="{StaticResource TextDim}" FontSize="13"
                                   TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,28"/>

                        <Border Background="{StaticResource BgPanel2}"
                                BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                CornerRadius="8" Padding="16,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Путь установки"
                                               Foreground="{StaticResource TextDim}" FontSize="12"/>
                                    <TextBlock Grid.Column="1" x:Name="InstallPathText"
                                               Foreground="{StaticResource Text}" FontSize="12"
                                               FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Браузеры"
                                               Foreground="{StaticResource TextDim}" FontSize="12"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Firefox, Chrome, Edge (зарегистрирует Native Messaging host для каждого)"
                                               Foreground="{StaticResource Text}" FontSize="12" TextWrapping="Wrap"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Права"
                                               Foreground="{StaticResource TextDim}" FontSize="12"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Только текущий пользователь — без UAC и без админа"
                                               Foreground="{StaticResource Text}" FontSize="12"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="ChkStartMenu" Margin="2,18,0,0" Foreground="{StaticResource TextDim}" IsChecked="True">
                            <TextBlock Text="Добавить ярлык в меню «Пуск»" FontSize="12"/>
                        </CheckBox>
                    </StackPanel>

                    <!-- PROGRESS screen -->
                    <StackPanel x:Name="ScreenProgress" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Устанавливаем..."
                                   Foreground="{StaticResource Text}" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ProgressStatus"
                                   Text="Подготовка..."
                                   Foreground="{StaticResource TextDim}" FontSize="13" Margin="0,10,0,28"/>
                        <ProgressBar x:Name="ProgressBar" Value="0" Maximum="100"/>
                    </StackPanel>

                    <!-- DONE screen -->
                    <StackPanel x:Name="ScreenDone" VerticalAlignment="Center" Visibility="Collapsed">
                        <Grid Width="56" Height="56" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <Ellipse Fill="{StaticResource Success}" Opacity="0.18"/>
                            <Path Stretch="Uniform" Width="28" Height="28" Stroke="{StaticResource Success}" StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M5 12 L10 17 L19 7"/>
                        </Grid>
                        <TextBlock x:Name="DoneTitle" Text="Готово!"
                                   Foreground="{StaticResource Text}" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DoneSubtitle"
                                   Text="Программа-помощник установлена. Откройте расширение Voice Clip Recorder в браузере — оно само подключится."
                                   Foreground="{StaticResource TextDim}" FontSize="13"
                                   TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- ERROR screen -->
                    <StackPanel x:Name="ScreenError" VerticalAlignment="Center" Visibility="Collapsed">
                        <Grid Width="56" Height="56" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <Ellipse Fill="{StaticResource Danger}" Opacity="0.18"/>
                            <Path Stretch="Uniform" Width="28" Height="28" Stroke="{StaticResource Danger}" StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M6 6 L18 18 M18 6 L6 18"/>
                        </Grid>
                        <TextBlock Text="Что-то пошло не так"
                                   Foreground="{StaticResource Text}" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ErrorMessage" Text=""
                                   Foreground="{StaticResource TextDim}" FontSize="13"
                                   TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Footer with action buttons -->
                <Border Grid.Row="2" Padding="40,18" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnSecondary"
                                Grid.Column="0" HorizontalAlignment="Left"
                                Style="{StaticResource GhostButton}"
                                Content="Отмена"
                                Click="Secondary_Click"/>

                        <Button x:Name="BtnPrimary"
                                Grid.Column="1" HorizontalAlignment="Right"
                                Style="{StaticResource PrimaryButton}"
                                Content="Установить"
                                MinWidth="160"
                                Click="Primary_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
