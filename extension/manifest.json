{
  "manifest_version": 3,
  "name": "Voice Clip Recorder",
  "description": "Пульт записи экрана и системного звука через локального помощника Windows.",
  "version": "1.3.0",
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "Voice Clip Recorder",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg",
      "48": "icons/icon.svg"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "tabs",
    "nativeMessaging"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "voice-clip-recorder@local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}